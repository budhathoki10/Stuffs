{
  "name": "pitchcraft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.mts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:integration && npm run test:e2e",
    "check:osm": "tsx --env-file-if-exists=.env scripts/check-osm.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "drizzle-orm": "^0.44.7",
    "next": "16.4.3",
    "node-html-parser": "^7.0.1",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
