# --- Core ---
# Any Postgres works (Supabase, Neon, Railway, local).
DATABASE_URL=postgres://pitchcraft:pitchcraft@localhost:5432/pitchcraft
# Public URL of the app, used in report links and payment return URLs.
APP_URL=http://localhost:3000
# Protects /api/cron/* endpoints. Vercel Cron sends it as a Bearer token.
CRON_SECRET=change-me

# --- AI pitches (optional: without a key, a built-in template writes the pitch) ---
ANTHROPIC_API_KEY=
# claude-opus-5-5 gives the best pitches (~$0.01 each). claude-haiku-5-5 is ~40x cheaper.
PITCH_MODEL=claude-opus-5-5

# --- Website audit ---
# Optional but recommended: the keyless PageSpeed quota is tiny.
PAGESPEED_API_KEY=
# Only for local testing: allow auditing localhost / private IPs.
AUDIT_ALLOW_PRIVATE_HOSTS=0

# --- Lead discovery ---
# "osm" (OpenStreetMap, free) or "mock" (fake businesses, for tests/dev).
LEADS_PROVIDER=osm
# Contact address sent to OpenStreetMap services, required by their usage policy.
OSM_CONTACT_EMAIL=you@example.com
# Used by the mock provider: base URL that serves fixture websites.
MOCK_SITE_BASE=http://127.0.0.1:4100

# --- Billing: Paddle (USD, global) ---
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_YEARLY=
PADDLE_WEBHOOK_SECRET=

# --- Billing: Khalti (NPR, Nepal) ---
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=
# NPR price for 30 days of Pro.
KHALTI_PRO_PRICE_NPR=999
